# Dependencies
node_modules/

# Android build outputs & caches
.gradle/
**/build/
**/local.properties
!build_all.*
*.apk.idsig

# Go test binaries & temporary files
*.tmp
*.bak
recovered_source/webrtc-signaling/*.exe
recovered_source/cloudphone-agent/*.exe

# GitHub file size limit protection (>100MB)
*.zip
*.tar.gz

# IDE & Python
.idea/
.vscode/
*.swp
*.swo
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Runtime persistent storage
data/
downloads/
**/data/
**/downloads/

# Runtime TLS Certificates (Private keys & generated certs)
certs/*.key
certs/*.p12
certs/*.crt
certs/*.pem
!certs/create_certs.sh
!certs/.gitkeep

